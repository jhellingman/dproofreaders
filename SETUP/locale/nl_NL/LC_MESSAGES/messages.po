msgid "Back to quiz page tutorial"
msgstr "Zurück zur Testseiten-Anleitung"

#: quiz/generic/quiz_page.inc:384 quiz/generic/quiz_page.inc:566
msgid "Back to quizzes home"
msgstr ""

