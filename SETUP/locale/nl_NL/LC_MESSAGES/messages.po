#: quiz/generic/data/qd_p_fraktur.inc:60 quiz/generic/quiz_defaults.inc:406
#: quiz/generic/quiz_defaults.inc:411 quiz/tuts/tut_p_old_1.php:16
msgid "Long s"
msgstr "Langes s"

#: quiz/generic/data/qd_p_fraktur.inc:61
msgid ""
"There is an '<kbd>f</kbd>' in the text that is actually a '<kbd>long s</"
"kbd>' in the image.  Although the letters look similar, the <kbd>long s</"
"kbd> is a different letter: it has a missing or incomplete crossbar (<kbd>ſ</"
"kbd>), while the <kbd>f</kbd> has a full crossbar.  Proofread the <kbd>long "
"s</kbd> just like a normal <kbd>s</kbd>."
msgstr ""
"Es ist ein „<kbd>f</kbd>“ im Text, das tatsächlich ein „<kbd>langes s</kbd>“ "
"im Bild ist. Auch wenn die Buchstaben ähnlich aussehen, ist das <kbd>lange "
"s</kbd> ein anderer Buchstabe: es hat einen fehlenden oder unvollständigen "
"Querstrich (<kbd>ſ</kbd>), während das <kbd>f</kbd> einen vollständigen "
"Querstrich hat. Lesen Sie das lange <kbd>s</kbd> einfach wie ein normales "
"<kbd>s</kbd> Korrektur."

#: quiz/generic/data/qd_p_fraktur.inc:65
msgid ""
"There is still a scanno: an '<kbd>f</kbd>' in the text where there is a "
"<kbd>long s</kbd> in the image."
msgstr ""
"Es ist noch ein Scanno: ein „<kbd>f</kbd>“ dort im Text, wo im Bild ein "
"langes <kbd>s</kbd> ist."

#: quiz/generic/data/qd_p_fraktur.inc:68
msgid "Fraktur characters"
msgstr "Fraktur-Zeichen"

#: quiz/generic/data/qd_p_fraktur.inc:69
msgid ""
"There is a '<kbd>y</kbd>' in the image that is marked as an '<kbd>n</kbd>' "
"in the text."
msgstr ""
"Es ist ein „<kbd>y</kbd>“ im Bild, dass als ein „<kbd>n</kbd>“ im Text "
"markiert ist."

